<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:tns="http://oletv.oletelecom.com.br/soap/invoice/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="invoice" targetNamespace="http://oletv.oletelecom.com.br/soap/invoice/">

  <wsdl:message name="generateFileRequest">
    <wsdl:part name='ciclo' type='xsd:string' />
  </wsdl:message>
  
  <wsdl:message name="generateFileResponse">
    <wsdl:part name='file' type='xsd:string' />
  </wsdl:message>

  <wsdl:message name="invoice_cycle_finishedRequest">
    <wsdl:part name='ciclo' type='xsd:string' />
  </wsdl:message>
  
  <wsdl:message name="invoice_cycle_finishedResponse">
    <wsdl:part name='retorno' type='xsd:string' />
  </wsdl:message>

  <wsdl:portType name="invoiceType">
  
    <wsdl:operation name="generateFile">
      <wsdl:input message="tns:generateFileRequest" />
      <wsdl:output message="tns:generateFileResponse" />
    </wsdl:operation>
    
    <wsdl:operation name="invoice_cycle_finished">
      <wsdl:input message="tns:invoice_cycle_finishedRequest" />
      <wsdl:output message="tns:invoice_cycle_finishedResponse" />
    </wsdl:operation>
    
  </wsdl:portType>
  
  <wsdl:binding name="invoiceSOAP" type="tns:invoiceType">
  
    <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http" />
    
    <wsdl:operation name="generateFile">
      <soap:operation soapAction="http://oletv.oletelecom.com.br/soap/invoice/generateFile" />
      <wsdl:input>
        <soap:body use="literal" namespace="http://oletv.oletelecom.com.br/soap/invoice/generateFileInput" />
      </wsdl:input>
      <wsdl:output>
        <soap:body use="literal" namespace="http://oletv.oletelecom.com.br/soap/invoice/generateFileOutput" />
      </wsdl:output>
    </wsdl:operation>
    
    <wsdl:operation name="invoice_cycle_finished">
      <soap:operation soapAction="http://oletv.oletelecom.com.br/soap/invoice/invoice_cycle_finished" />
      <wsdl:input>
        <soap:body use="literal" namespace="http://oletv.oletelecom.com.br/soap/invoice/invoice_cycle_finishedInput" />
      </wsdl:input>
      <wsdl:output>
        <soap:body use="literal" namespace="http://oletv.oletelecom.com.br/soap/invoice/invoice_cycle_finishedOutput" />
      </wsdl:output>
    </wsdl:operation>
    
  </wsdl:binding>
  
  <wsdl:service name="invoice">
    <wsdl:port binding="tns:invoiceSOAP" name="invoiceSOAP">
      <soap:address location="http://oletv.oletelecom.com.br/soap/invoice/" />
    </wsdl:port>
  </wsdl:service>
  
</wsdl:definitions>
