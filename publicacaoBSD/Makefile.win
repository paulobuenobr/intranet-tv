# Project: publicacaoBSD
# Makefile created by Dev-C++ 4.9.9.2

CPP  = g++.exe
CC   = gcc.exe
WINDRES = windres.exe
RES  = 
OBJ  = publicacaoBSD.o Arquivo.o Funcoes.o Interface.o Ponto.o Publicacao.o $(RES)
LINKOBJ  = publicacaoBSD.o Arquivo.o Funcoes.o Interface.o Ponto.o Publicacao.o $(RES)
LIBS =  -L"C:/Dev-Cpp/lib"  
INCS =  -I"C:/Dev-Cpp/include" 
CXXINCS =  -I"C:/Dev-Cpp/lib/gcc/mingw32/3.4.2/include"  -I"C:/Dev-Cpp/include/c++/3.4.2/backward"  -I"C:/Dev-Cpp/include/c++/3.4.2/mingw32"  -I"C:/Dev-Cpp/include/c++/3.4.2"  -I"C:/Dev-Cpp/include"  -I"D:/Paginas/publicacaoBSD" 
BIN  = publicacaoBSD.exe
CXXFLAGS = $(CXXINCS)  
CFLAGS = $(INCS)  
RM = rm -f

.PHONY: all all-before all-after clean clean-custom

all: all-before publicacaoBSD.exe all-after


clean: clean-custom
	${RM} $(OBJ) $(BIN)

$(BIN): $(OBJ)
	$(CPP) $(LINKOBJ) -o "publicacaoBSD.exe" $(LIBS)

publicacaoBSD.o: publicacaoBSD.cpp
	$(CPP) -c publicacaoBSD.cpp -o publicacaoBSD.o $(CXXFLAGS)

Arquivo.o: Arquivo.cpp
	$(CPP) -c Arquivo.cpp -o Arquivo.o $(CXXFLAGS)

Funcoes.o: Funcoes.cpp
	$(CPP) -c Funcoes.cpp -o Funcoes.o $(CXXFLAGS)

Interface.o: Interface.cpp
	$(CPP) -c Interface.cpp -o Interface.o $(CXXFLAGS)

Ponto.o: Ponto.cpp
	$(CPP) -c Ponto.cpp -o Ponto.o $(CXXFLAGS)

Publicacao.o: Publicacao.cpp
	$(CPP) -c Publicacao.cpp -o Publicacao.o $(CXXFLAGS)
